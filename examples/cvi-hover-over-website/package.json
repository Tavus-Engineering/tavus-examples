{
  "name": "cvi-transparent-background",
  "author": "tavus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "format": "npx @biomejs/biome format --write ./",
    "lint": "npx @biomejs/biome lint --write ./",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.73.0",
    "@daily-co/daily-react": "^0.22.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.3",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
